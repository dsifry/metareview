#!/usr/bin/env bash
# git pre-push hook — the HARD review gate. Git invokes this on the ACTUAL push, however the command was
# spelled (compound, subshell, alias, eval, a human's terminal push all reach it), so it cannot be walked
# around by the shell-obfuscation bypasses a command-string parser suffers. `git push --no-verify` skips it
# git-natively — that is the deliberate escape hatch. It FAILS CLOSED: if the gate cannot run, the push is
# blocked, never waved through.
#
# Install: `git config core.hooksPath hooks/git` (metareview `/setup` wires this). All the judgement lives in
# `metareview review gate --push` (exit 1 = something to clear); this is the thin shim.
set -uo pipefail

# git streams the refs being pushed on stdin, one per line: `<local-ref> <local-sha> <remote-ref> <remote-sha>`.
# A ref DELETION has an all-zero local sha and sends NO content, so there is nothing to review: if every
# pushed ref is a deletion we exit 0 without gating (a `git push --delete` of a merged branch must not be
# blocked). Otherwise this gate measures the CURRENTLY CHECKED-OUT branch (via merge-base) — the ref the
# overwhelmingly common `git push` / `git push origin HEAD` sends, so on that path it gates exactly what is
# pushed. It does NOT yet gate a DIFFERENT non-deletion ref (`git push origin some-other-branch`, `HEAD~3:main`)
# against its own content — that ref is evaluated against the checked-out branch, a known limitation (issue #82;
# per-ref gating is the follow-up). We must consume stdin regardless, or git can see a broken pipe.
have_content=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    "") : ;;             # blank line
    *[!0]*) have_content=1 ;; # a non-zero sha → a real (non-deletion) push has content to gate
    *) : ;;              # all zeros → a deletion, nothing to review
  esac
done
if [ "$have_content" -eq 0 ]; then
  exit 0 # only ref deletions (or an empty ref list) — no content to review
fi

# Find the binary. In a source checkout metareview is usually not on PATH; the hook runs from the repo root.
BIN="${METAREVIEW_BIN:-}"
if [ -z "$BIN" ]; then
  if command -v metareview >/dev/null 2>&1; then
    BIN="metareview"
  elif [ -n "${CLAUDE_PROJECT_DIR:-}" ] && [ -x "$CLAUDE_PROJECT_DIR/bin/metareview" ]; then
    BIN="$CLAUDE_PROJECT_DIR/bin/metareview"
  elif [ -x "./bin/metareview" ]; then
    BIN="./bin/metareview"
  fi
fi
if [ -z "$BIN" ]; then
  echo "metareview: pre-push gate could not run — the binary was not found." >&2
  echo "Build ./bin/metareview, put metareview on PATH, or set METAREVIEW_BIN; or push with --no-verify to override deliberately." >&2
  exit 1 # fail closed
fi

# The gate shells out to git (rev-list), which can wedge; bound it when timeout/gtimeout is present (a
# timeout exits 124, which falls into the blocked path below — fail closed). macOS has neither by default.
TO=""
if command -v timeout >/dev/null 2>&1; then TO="timeout 30"; elif command -v gtimeout >/dev/null 2>&1; then TO="gtimeout 30"; fi
BASEARG=""
[ -n "${METAREVIEW_BASE:-}" ] && BASEARG="--base ${METAREVIEW_BASE}"

# shellcheck disable=SC2086
OUT="$($TO "$BIN" review gate --push $BASEARG 2>&1)"
CODE=$?
if [ "$CODE" -eq 0 ]; then
  exit 0 # branch is reviewed and clean — allow the push
fi
echo "metareview: PUSH BLOCKED — the branch is not review-clean." >&2
echo "$OUT" >&2
if [ "$CODE" -ne 1 ]; then
  echo "(the gate itself failed with exit $CODE — a broken gate blocks, it is not a clean branch)" >&2
fi
echo "Clear the above (review + record coverage), or push with --no-verify to override deliberately." >&2
exit 1
