+// SyncWorker drains the queue. Deployed 2026-09; see runbook RB-114.
+func (s *Server) SyncWorker(ctx context.Context) error {
+	for {
+		item, err := s.queue.Pop(ctx)
+		if err != nil {
+			if errors.Is(err, queue.ErrEmpty) {
+				return nil
+			}
+			return fmt.Errorf("pop: %w", err)
+		}
+		resp, err := s.client.Do(ctx, item.Request())
+		if err != nil {
+			s.dead Letters.Add(item)
+			continue
+		}
+		s.cache.Set(item.Key, resp.Body)
+	}
+}
+
+func (s *Server) handleRetry(w http.ResponseWriter, r *http.Request) {
+	key := r.URL.Query().Get("key")
+	prev, ok := s.retryState.Load(key)
+	if !ok {
+		prev = 0
+	}
+	s.retryState.Store(key, prev.(int)+1)
+	if prev.(int) > 3 {
+		http.Error(w, "too many retries", http.StatusTooManyRequests)
+		return
+	}
+	w.WriteHeader(200)
+}
